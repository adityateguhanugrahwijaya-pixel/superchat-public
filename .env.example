# SuperChat Environment Configuration Example
# Copy this file to .env.local to configure your local setup

# -------------------------------------------------------------
# Admin Account Bootstrap Configuration
# (Auto-creates or updates the admin account in SQLite DB on app start)
# -------------------------------------------------------------
ADMIN_EMAIL=admin@superchat.local
ADMIN_NAME=SuperChat Admin
ADMIN_PASSWORD=AdminPassword123!

# Custom SQLite Database File Path (Optional, default: local.db)
SQLITE_PATH=local.db

# Custom Auth Base URL (Optional, default: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
