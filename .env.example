# SuperChat Environment Configuration Example
# Copy this file to .env.local to configure your local setup

# -------------------------------------------------------------
# 1. Admin Account Bootstrap Configuration
# (Auto-creates or updates the admin account in SQLite DB on app start)
# -------------------------------------------------------------
ADMIN_EMAIL=admin@superchat.local
ADMIN_NAME=SuperChat Admin
ADMIN_PASSWORD=AdminPassword123!

# -------------------------------------------------------------
# 2. Bynara AI Router API Key (Required for AI model routing)
# Get key at: https://router.bynara.id/register?ref=VTP3U9TU
# -------------------------------------------------------------
BYNARA_API_KEY=your_bynara_api_key_here

# -------------------------------------------------------------
# 3. BetterAuth Encryption Secret (Required - Min 32 chars)
# -------------------------------------------------------------
BETTER_AUTH_SECRET=superchat_secret_key_bynara_auth_32bytes_random_hex_secret

# -------------------------------------------------------------
# 4. Auth & Database Settings (Optional)
# -------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
SQLITE_PATH=local.db
